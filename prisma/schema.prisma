// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  name      String?
  username  String? // Clerk can provide a username
  image     String? // Clerk profile image URL
  phone     String? // Clerk phone number if available
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Worker {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  name      String?
  username  String?
  image     String?
  phone     String?
  dept      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FollowUp {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  phone     String
  email     String?
  address   String
  createdAt DateTime @default(now())
  handledAt DateTime? // set when a team member marks it handled
  handledBy String?
}

model HouseFellowship {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  center        String
  address       String
  zone          String
  teacher       String
  teacher_phone String?
  host          String
  host_phone    String?
  createdAt     DateTime @default(now())
}

model PrayerRequest {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  fullname      String
  phone         String
  email         String?
  prayerRequest String
  createdAt     DateTime @default(now())
  handledAt     DateTime? // set when a team member marks it handled
  handledBy     String?
}

model Testimony {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  fullname  String
  phone     String
  email     String?
  testimony String
  createdAt DateTime @default(now())
}
model Enquiry {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  fullname  String
  phone     String
  email     String?
  enquiry   String
  createdAt DateTime @default(now())
  handledAt DateTime? // set when a team member marks it handled
  handledBy String?
}

model Elder {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  fullname  String
  phone     String
  email     String?
  gender    String
  createdAt DateTime @default(now())
}

model Men {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  fullname  String
  phone     String
  email     String?
  createdAt DateTime @default(now())
}

model Women {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  fullname  String
  phone     String
  email     String?
  createdAt DateTime @default(now())
}

model Youth {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  fullname  String
  phone     String
  email     String?
  gender    String
  createdAt DateTime @default(now())
}

model Teen {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  fullname  String
  phone     String
  email     String?
  gender    String
  createdAt DateTime @default(now())
}

model Child {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  fullname          String
  gender            String
  dob               String
  guardian_fullname String
  guardian_phone    String
  guardian_email    String?
  guardian_gender   String
  createdAt         DateTime @default(now())
}

model Event {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  desc      String
  venue     String
  datetime  String
  reglink   String?
  image     String?
  createdAt DateTime @default(now())
}

// Dashboard access. Managed by super admins on the Team tab; matched against the signed-in
// user's verified Clerk emails. Role values: see src/lib/roles.ts.
model TeamMember {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique // stored lowercase
  name      String?
  role      String
  dept      String? // HODs: limits the Workers list to this department
  addedBy   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Single row (key = "default"), edited by super admins on the Notifications tab.
model NotificationSettings {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  key             String    @unique @default("default")
  whatsappEnabled Boolean   @default(false)
  emailEnabled    Boolean   @default(false)
  prayerWhatsapp  String? // number that gets new prayer requests on WhatsApp
  convertWhatsapp String? // number that gets new converts on WhatsApp
  // CallMeBot (free) API keys, one per receiving number; never sent to the browser
  prayerWhatsappKey  String?
  convertWhatsappKey String?
  // Prayer text goes through a third party on WhatsApp, so it's opt-in
  prayerTextOnWhatsapp Boolean @default(false)
  prayerEmails    String[]
  convertEmails   String[]
  lastError       String?
  lastErrorAt     DateTime?
  updatedBy       String?
  updatedAt       DateTime  @updatedAt
}
