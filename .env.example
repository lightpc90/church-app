# Copy to .env (gitignored) and fill in. See README for what each one does.
DATABASE_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
SUPER_ADMIN_EMAILS=
ADMIN_EMAILS=
NEXT_PUBLIC_API_KEY=
YOUTUBE_API_KEY=
INSTAGRAM_ACCESS_TOKEN=

# Email alerts (Resend). Use a *sending-only* key, restricted to your domain.
RESEND_API_KEY=
# Until your domain is verified: "RCCG Beautiful Gate <onboarding@resend.dev>" (delivers only to your Resend account's email)
NOTIFY_EMAIL_FROM=
# Default recipients (comma separated); a super admin can override them on the dashboard
NOTIFY_PRAYER_EMAILS=
NOTIFY_CONVERT_EMAILS=

# Optional paid WhatsApp fallback (free CallMeBot keys are set on the dashboard)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_PRAYER_TEMPLATE_SID=
TWILIO_CONVERT_TEMPLATE_SID=
